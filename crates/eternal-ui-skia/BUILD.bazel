load(
    "@rules_rust//rust:defs.bzl",
    "rust_doc",
    "rust_library",
    "rust_test",
)

package(default_visibility = ["//visibility:public"])

# Cargo.toml feeds crate_universe in //MODULE.bazel.
exports_files([
    "LICENSE",
    "Cargo.toml",
])

rust_library(
    name = "eternal-ui-skia",
    srcs = glob(["src/**/*.rs"]),
    crate_name = "eternal_ui_skia",
    edition = "2024",
    deps = [
        "//crates/eternal-ui",
        "@crates//:skia-safe",
    ],
)

rust_test(
    name = "render_test",
    srcs = ["tests/render.rs"],
    edition = "2024",
    deps = [
        ":eternal-ui-skia",
        "//crates/eternal-ui",
        "@crates//:skia-safe",
    ],
)

rust_doc(
    name = "docs",
    crate = ":eternal-ui-skia",
)
