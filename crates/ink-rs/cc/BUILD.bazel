load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# The C++ facade. Only `ink_ffi.h` is part of the FFI surface; everything that
# mentions an Ink or STL type lives in ink_ffi.cc.
#
# The Rust declarations for this header are generated by
# //tools/bindgen/generate.sh and checked in as
# //crates/ink-rs/src/ffi/generated.rs, so there is no code generation in the
# build itself. //crates/ink-rs just links this.
cc_library(
    name = "ink_ffi",
    srcs = ["ink_ffi.cc"],
    hdrs = ["ink_ffi.h"],
    deps = [
        "@abseil-cpp//absl/status",
        "@abseil-cpp//absl/status:statusor",
        "@abseil-cpp//absl/types:span",
        "@ink//ink/brush",
        "@ink//ink/brush:brush_family",
        "@ink//ink/brush:brush_paint",
        "@ink//ink/brush:stock_brushes",
        "@ink//ink/color",
        "@ink//ink/color:color_space",
        "@ink//ink/geometry:angle",
        "@ink//ink/geometry:envelope",
        "@ink//ink/geometry:mesh",
        "@ink//ink/geometry:mutable_mesh",
        "@ink//ink/geometry:partitioned_mesh",
        "@ink//ink/geometry:point",
        "@ink//ink/geometry:rect",
        "@ink//ink/strokes:in_progress_stroke",
        "@ink//ink/strokes:stroke",
        "@ink//ink/strokes/input:stroke_input",
        "@ink//ink/strokes/input:stroke_input_batch",
        "@ink//ink/types:duration",
        "@ink//ink/types:physical_distance",
    ],
)
