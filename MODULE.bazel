module(
    name = "eternal_pixels",
    version = "0.1.0",
)

bazel_dep(name = "abseil-cpp", version = "20260526.0")
bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_rust", version = "0.71.3")

#################################################################################
## Google Ink - the C++ stroke library the bindings wrap.
#################################################################################

# Ink is not on the Bazel Central Registry, so it comes straight from git.
bazel_dep(name = "ink", version = "1.1.0")
git_override(
    module_name = "ink",
    commit = "dd67b9bb6524d002d5a43e1fe9286066a810af1e",  # main as of 2026-09-18
    patch_strip = 1,
    patches = ["//patches/ink:0001-Drop-toolchains_llvm-so-Ink-can-be-a-dependency.patch"],
    remote = "https://github.com/google/ink.git",
)

# Ink depends on Dawn, which is not on the BCR either, and pulls it in with a
# git_override plus a patch that makes Dawn usable as a dependency at all.
# Bazel only honours overrides from the root module, so without repeating it
# here resolution fails with "module dawn@v20260731.171941 not found in
# registries". The commit and the patch are copies of Ink's.
bazel_dep(name = "dawn", version = "v20260731.171941")
git_override(
    module_name = "dawn",
    commit = "cd2d5a667d1140af6e89f4c4c24f6545e1d5d2d7",  # v20260731.171941
    patch_strip = 1,
    patches = ["//patches/dawn:0001-Fix-MODULE.bazel-so-Dawn-can-be-used-as-a-dependency.patch"],
    remote = "https://dawn.googlesource.com/dawn.git",
)

#################################################################################
## Rust crates from crates.io
#################################################################################

# crate_universe reads the crates' Cargo.toml files and generates a Bazel
# target for every dependency, reachable as @crates//:<name>. Cargo.lock pins
# the versions; the JSON lockfile is crate_universe's own rendering of the
# resolved graph. Only eternal-styler has dependencies so far; add other
# manifests here as crates grow some.
#
# After changing a Cargo.toml or either lockfile:
#
#     CARGO_BAZEL_REPIN=1 bazel build //...
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//crates/eternal-styler:Cargo.lock",
    lockfile = "//third_party:cargo-bazel-lock.json",
    manifests = ["//crates/eternal-styler:Cargo.toml"],
)
use_repo(crate, "crates")

#################################################################################
## Toolchains
#################################################################################

# Ink registers an LLVM toolchain from its own MODULE.bazel, which cannot work
# for a dependency, so the patch above removes it and the host toolchain is
# registered here instead. Root-module registrations are resolved first.
apple_cc_configure = use_extension(
    "@apple_support//crosstool:setup.bzl",
    "apple_cc_configure_extension",
)
use_repo(
    apple_cc_configure,
    "local_config_apple_cc",
    "local_config_apple_cc_toolchains",
)

# Stable Rust. The FFI declarations are generated by bindgen and checked in, so
# nothing here needs nightly.
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.90.0"],
)
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@local_config_apple_cc_toolchains//:all",
    "@rust_toolchains//:all",
)
